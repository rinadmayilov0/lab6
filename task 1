CSS

table {
    width: 100%;
    border-collapse: collapse;
    font-family: Arial;
}
th, td {
    padding: 12px;
    text-align: left;
}
.basliq {
    background-color: #1a3644;
    color: white;
}
tr:nth-child(even) {
    background-color: #f2f2f2;
}
.badge {
    background-color: #2ecc71;
    color: white;
    padding: 4px 8px;
    border-radius: 10px;
}
