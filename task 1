<!DOCTYPE html>
<html>
<head>
    <link rel="stylesheet" href="style1_cedvel.css">
</head>
<body>

    <table>
        <tr class="basliq">
            <th>Məhsul</th>
            <th>Qiymət</th>
            <th>Status</th>
        </tr>
        <tr>
            <td>Laptop</td>
            <td>1200₼</td>
            <td><span class="badge">Mövcud</span></td>
        </tr>
        <tr>
            <td>Telefon</td>
